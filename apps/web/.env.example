# The public origin, used for canonical URLs, the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the CMS API lives. Server-side only — the browser never calls it directly.
API_URL=http://localhost:4000/api/v1

# Must match REVALIDATE_SECRET in apps/api/.env. The API sends it as a header
# when it asks this app to re-render after a publish.
REVALIDATE_SECRET=
