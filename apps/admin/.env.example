# The API the panel talks to. Browser-visible, so it must be the public origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Where uploaded media is served from, for next/image.
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000/uploads

# The public site, for the "view on site" links beside each piece of content.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
