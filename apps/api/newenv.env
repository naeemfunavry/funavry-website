NODE_ENV=production
API_PREFIX=api/v1

DB_HOST=funavry-database-hannanraja1992-6756.d.aivencloud.com
DB_PORT=13343
DB_USERNAME=avnadmin
DB_PASSWORD=<new password after reset>
DB_DATABASE=defaultdb
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

JWT_ACCESS_SECRET=<random, 48+ chars>
JWT_REFRESH_SECRET=<a DIFFERENT random value>
COOKIE_SECRET=<another random value>
REVALIDATE_SECRET=<another random value>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=funavry-api
JWT_AUDIENCE=funavry-admin

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@funavry.org
