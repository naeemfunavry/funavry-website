# ---------------------------------------------------------------- runtime --
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# --------------------------------------------------------------- database --
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=funavry_app
DB_PASSWORD=change-me
DB_DATABASE=funavry_cms
# Never true. Schema changes go through migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ------------------------------------------------------------------- auth --
# Generate each with: openssl rand -base64 48
# The two MUST differ — a leaked access secret must not also mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=funavry-api
JWT_AUDIENCE=funavry-admin
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --------------------------------------------------------- seeded account --
# Seeded once, hashed with Argon2id, flagged to force a change on first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@funavry.com
SEED_ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------- cookies --
COOKIE_DOMAIN=localhost
# Must be true in production — the refresh cookie is credentials.
COOKIE_SECURE=false
# openssl rand -base64 48
COOKIE_SECRET=

# ------------------------------------------------------------------- CORS --
# Exact origins, comma separated. No wildcard: requests carry credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------- revalidation --
WEB_APP_URL=http://localhost:3000
# openssl rand -base64 32
REVALIDATE_SECRET=

# ---------------------------------------------------------------- uploads --
STORAGE_DRIVER=LOCAL
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_URL=http://localhost:4000/uploads
UPLOAD_MAX_BYTES=10485760

# Switch STORAGE_DRIVER to S3 and fill these in to move media to object storage.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# ---------------------------------------------------------------- logging --
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true

# --------------------------------------------------------------- throttle --
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5
# Reverse proxy hops to trust when resolving the client IP.
TRUST_PROXY_HOPS=1
